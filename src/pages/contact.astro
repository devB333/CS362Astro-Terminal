---
import Layout from '../layouts/Layout.astro';
import Frame from '../components/Frame.astro';

// Public Worker endpoint only. Never put the Discord webhook URL here.
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT || '';
---

<Layout title="CONTACT" description="Send me a message.">
  <Frame title="CONTACT">
    <div class="prose contact-intro">
      <h1>SEND A TRANSMISSION</h1>
      <p>Leave your contact details and a message. I’ll reply by email.</p>
    </div>
    <form id="contact-form" data-endpoint={endpoint}>
      <div class="contact-grid">
        <label for="contact-name">NAME
          <input id="contact-name" name="name" autocomplete="name" required maxlength="100" />
        </label>
        <label for="contact-email">EMAIL
          <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="254" />
        </label>
      </div>
      <label for="contact-message">MESSAGE
        <textarea id="contact-message" name="message" rows="7" required maxlength="3000"></textarea>
      </label>
      <div class="contact-trap" aria-hidden="true" inert>
        <label>Leave this empty<input name="website" tabindex="-1" autocomplete="off" /></label>
      </div>
      <p class="contact-note">Your details and message will be sent privately to my Discord inbox.</p>
      <button id="contact-submit" type="submit" disabled data-sfx>[ SEND MESSAGE ]</button>
      <p id="contact-status" role="status" aria-live="polite" aria-atomic="true"></p>
      <noscript>Please enable JavaScript to send a message.</noscript>
    </form>
  </Frame>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const button = document.querySelector<HTMLButtonElement>('#contact-submit');
  const status = document.querySelector<HTMLParagraphElement>('#contact-status');

  if (form && button && status) {
    const endpoint = form.dataset.endpoint;
    button.disabled = !endpoint;
    if (!endpoint) status.textContent = '> Contact is temporarily unavailable. Please check back later.';
    let sending = false;
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (sending || !endpoint || !form.reportValidity()) return;
      sending = true;
      button.disabled = true;
      form.setAttribute('aria-busy', 'true');
      button.textContent = '[ SENDING… ]';
      status.textContent = '> Transmitting message…';
      const data = new FormData(form);
      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(data)),
          signal: AbortSignal.timeout(20000),
        });
        const result = await response.json();
        if (!response.ok || result.ok !== true) {
          throw new Error(typeof result.error === 'string' ? result.error : 'Unable to send. Please try again later.');
        }
        form.reset();
        status.textContent = '> Message received. Thank you — I’ll reply by email.';
      } catch (error) {
        status.textContent = '> ' + (error instanceof Error && error.name === 'Error'
          ? error.message
          : 'Delivery could not be confirmed. Your message is still here; please wait before trying again.');
      } finally {
        sending = false;
        button.disabled = false;
        button.textContent = '[ SEND MESSAGE ]';
        form.removeAttribute('aria-busy');
      }
    });
  }
</script>

<style>
  .contact-intro { margin-bottom: 28px; }
  h1 { font-size: 1.4em; font-weight: normal; line-height: 1.3; color: var(--fg-bright); }
  form { display: grid; gap: 22px; }
  .contact-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; }
  label { display: grid; gap: 8px; min-width: 0; }
  input, textarea, button { font: inherit; letter-spacing: inherit; color: var(--fg); background: var(--bg-deep); border: 1px solid var(--fg); border-radius: 0; }
  input, textarea { width: 100%; min-width: 0; padding: 10px 12px; }
  textarea { resize: vertical; min-height: 160px; }
  button { justify-self: start; padding: 10px 18px; min-height: 44px; cursor: pointer; }
  button:hover:not(:disabled) { background: var(--fg); color: var(--bg); text-shadow: none; }
  button:disabled { opacity: .6; cursor: not-allowed; }
  .contact-note { font-size: .9em; }
  #contact-status { min-height: 1.5em; overflow-wrap: anywhere; }
  .contact-trap { display: none; }
  @media (max-width: 640px) { .contact-grid { grid-template-columns: 1fr; } }
</style>
